{
  "expo": {
    "name": "SunPower",
    "slug": "sunpower-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "sunpower",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6B4FD6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.visionx.sunpower",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to securely access your solar account",
        "NSCameraUsageDescription": "Take photos for service requests",
        "NSLocationWhenInUseUsageDescription": "Find nearby service centers"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6B4FD6"
      },
      "package": "com.visionx.sunpower",
      "permissions": [
        "USE_BIOMETRIC",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "SEND_SMS",
        "RECEIVE_SMS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6B4FD6"
        }
      ]
    ]
  }
}
